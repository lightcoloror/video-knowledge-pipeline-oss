  "description": "Clone-portable VKP discovery, synthetic offline video-evidence smoke, material manifests, candidate review artifacts, personal Vlog and local-trial panorama CLI/MCP. Metadata never authorizes execution.",
  "executionAuthority": "none_metadata_only",
  "health": {
    "doctor": {
      "command": "video-knowledge-portable doctor",
      "kind": "cli",
      "profile": "quick",
      "timeout_seconds": 10
    },
    "proves_current_online": false,
    "status_semantics": "Quick local contract readiness; ASR/model readiness and current online state are separate."
  },
  "id": "video-knowledge-pipeline",
  "inputs": [
    {
      "contract": "video_knowledge_pipeline.material_manifest_fixture.v1",
      "name": "synthetic_bundle",
      "required": false,
      "status": "bundled_synthetic_only"
    },
    {
      "contract": "local media reference",
      "name": "local_media",
      "required": false,
      "status": "owner_gated_not_used_by_portable_smoke"
    },
    {
      "contract": "model-provider-gateway route and consent refs",
      "name": "reviewed_model_route",
      "required": false,
      "status": "blocked_without_owner_consent"
    },
    {
      "contract": "video_knowledge_pipeline.panorama_profile.v1",
      "name": "confirmed_panorama_bundle",
      "required": false,
      "status": "local_trial_explicit_projection_required"
    }
  ],
  "interfaces": {
    "canonical": [
      {
        "command": "video-knowledge-portable doctor",
        "kind": "cli",
        "mode": "read_only",
        "profile": "quick",
        "timeout_seconds": 10
      },
      {
        "command": "python -m video_knowledge_pipeline.portable doctor",
        "kind": "python_module",
        "mode": "read_only",
        "profile": "quick",
        "timeout_seconds": 10
      },
      {
        "command": "video-knowledge material-manifest-validate <bundle>",
        "kind": "cli",
        "mode": "read_only"
      },
      {
        "command": "personal-vlog-doctor",
        "kind": "cli",
        "mode": "read_only",
        "profile": "personal-vlog-v1",
        "timeout_seconds": 10
      },
      {
        "command": "panorama-doctor <media-or-bundle>",
        "kind": "cli",
        "mode": "read_only_fail_closed",
        "profile": "panorama-v1",
        "timeout_seconds": 30
      },
      {
        "command": "panorama-prepare <bundle> --projection <type>",
        "kind": "cli",
        "mode": "candidate_plan_only",
        "profile": "panorama-v1"
      },
      {
        "command": "panorama-run <bundle> --run-id <id> [--execute-projection]",
        "kind": "cli",
        "mode": "explicit_local_derived_frames_only",
        "profile": "panorama-v1"
      },
      {
        "command": "panorama-import <bundle> --run-id <id> --input-json <result.json>",
        "kind": "cli",
        "mode": "hash_bound_atomic_import",
        "profile": "panorama-v1"
      },
      {
        "command": "panorama-status <bundle> [--run-id <id>]",
        "kind": "cli",
        "mode": "read_only",
        "profile": "panorama-v1"
      },
      {
        "command": "panorama-restore <bundle> --run-id <id> [--execute --confirm-run-id <id>]",
        "kind": "cli",
        "mode": "plan_only_unless_exact_confirmation",
        "profile": "panorama-v1"
      }
    ],
    "http": [],
    "mcp": [
      {
        "command": "video-knowledge-mcp",
        "kind": "mcp",
        "mode": "read_only_or_explicit_owner_gated",
        "transport": "stdio"
      },
      {
        "command": "video-knowledge-personal-vlog-mcp",
        "kind": "mcp",
        "mode": "candidate_only_explicit_source_root",
        "profile": "personal-vlog-v1",
        "transport": "stdio"
      },
      {
        "command": "video-knowledge-panorama-mcp",
        "kind": "mcp",
        "mode": "local_trial_explicit_projection_and_import",
        "profile": "panorama-v1",
        "transport": "stdio"
      }
    ],
    "windows_wrappers": []
  },
